# Database PostgreSQL (Gratis dari https://supabase.com atau https://neon.tech)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# JWT Secret (String acak untuk tanda tangan token login user)
JWT_SECRET="super-secret-jwt-key-please-change-in-production-12345"

# Upstream Provider AI Master (Penyedia AI yang akan diforward oleh website Anda)
# Bisa menggunakan OpenRouter (https://openrouter.ai), OpenAI asli, DeepSeek, atau 9Router lokal
UPSTREAM_BASE_URL="https://openrouter.ai/api/v1"
UPSTREAM_API_KEY="sk-or-v1-your-master-openrouter-key"

# Payment Gateway Midtrans (Dapatkan di https://dashboard.midtrans.com)
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"

# URL Aplikasi
NEXT_PUBLIC_APP_URL="http://localhost:3000"
