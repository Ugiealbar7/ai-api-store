# ==========================================
# DATABASE POSTGRESQL (Supabase / Neon)
# ==========================================
# Di Vercel / Production:
# Gunakan connection pooling Supabase (port 6543 / pgbouncer) untuk DATABASE_URL
# Gunakan direct connection (port 5432) untuk DIRECT_URL
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==========================================
# AUTHENTICATION
# ==========================================
# String acak untuk signing JWT login pengguna
JWT_SECRET="super-secret-jwt-key-please-change-in-production-12345"

# ==========================================
# UPSTREAM AI PROVIDER MASTER
# ==========================================
# PENTING DI VERCEL / PRODUCTION:
# JANGAN gunakan http://127.0.0.1:20128 di Vercel karena Vercel ada di cloud (tidak bisa akses laptop Anda).
# Gunakan salah satu pilihan berikut:
# Pilihan A (Rekomendasi): OpenRouter (https://openrouter.ai)
UPSTREAM_BASE_URL="https://openrouter.ai/api/v1"
UPSTREAM_API_KEY="sk-or-v1-your-master-openrouter-key"

# Pilihan B: Jika tetap ingin pakai 9Router lokal di laptop, expose dengan Cloudflare Tunnel:
# UPSTREAM_BASE_URL="https://your-9router-tunnel.trycloudflare.com/v1"
# UPSTREAM_API_KEY="sk-your-9router-key"

# ==========================================
# PAYMENT GATEWAY & KONFIRMASI WHATSAPP
# ==========================================
# Nomor WhatsApp Admin untuk konfirmasi top up QRIS (format: 628xxxxxxxxxx)
NEXT_PUBLIC_ADMIN_WHATSAPP="62895325852554"

# Midtrans (Opsional jika ingin otomatisasi webhook Midtrans)
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"

# ==========================================
# APP URL
# ==========================================
NEXT_PUBLIC_APP_URL="https://ai-api-store-iota.vercel.app"
